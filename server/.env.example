PORT=5000
# Copy the full mongodb+srv:// URI from Atlas > Connect > Drivers.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed frontend origins. Keep the active Vercel deployment and local dev origins.
CLIENT_URL=http://localhost:5173,http://192.168.31.81:5173,https://alpha-chat-9kxx-4dfof6hv8-prince-f1e5.vercel.app
# Optional; reserved for a future verified Google identity flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
