PORT=5000
# Copy the full mongodb+srv:// URI from Atlas > Connect > Drivers.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173,http://192.168.31.81:5173
# Optional; reserved for a future verified Google identity flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
